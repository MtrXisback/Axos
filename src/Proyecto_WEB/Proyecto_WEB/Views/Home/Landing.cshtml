@{
    ViewData["Title"] = "AXON | Connecting Tech Pulse";
    Layout = "_Layout";
}

<div class="hero-axon position-relative overflow-hidden text-white">
    <div class="axon-grid-overlay"></div> <div class="container position-relative py-5">
        <div class="row align-items-center py-5">
            <div class="col-lg-7 text-center text-lg-start mt-5">
                <span class="badge rounded-pill bg-primary px-3 py-2 mb-3 animate__animated animate__fadeInDown">
                    <i class="bi bi-cpu-fill me-2"></i> POWERED BY CIBERTEC TALENT
                </span>
                <h1 class="display-2 fw-bold mb-3 animate__animated animate__fadeInLeft">
                    Conecta con el <span class="text-gradient">Pulso Tecnológico</span>
                </h1>
                <p class="lead mb-5 text-light opacity-75 animate__animated animate__fadeInLeft animate__delay-1s">
                    Axon es el canal neuronal que une a los mejores desarrolladores de Cibertec
                    con las empresas que lideran la transformación digital. No solo busques chamba, encuentra tu lugar en el stack.
                </p>
                <div class="d-grid gap-3 d-sm-flex justify-content-sm-center justify-content-lg-start animate__animated animate__fadeInUp animate__delay-2s">
                    <a asp-action="Buscador" class="btn btn-axon btn-lg px-5 shadow-neon">
                        Explorar Vacantes <i class="bi bi-arrow-right-short ms-1"></i>
                    </a>
                    <a asp-controller="Acceso" asp-action="Registrar" class="btn btn-outline-light btn-lg px-5 rounded-pill border-2">
                        Unirse a la Red
                    </a>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block animate__animated animate__zoomIn animate__delay-1s">
                <div class="axon-hero-image-container">
                    <img src="https://img.freepik.com/free-vector/digital-world-map-dots-connecting-lines_1017-14282.jpg"
                         class="img-fluid floating-axon" alt="Axon Connect">
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container mt-n5 position-relative">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="axon-card p-4 text-center">
                <div class="icon-circle bg-light-primary mb-3">
                    <i class="bi bi-terminal-fill fs-3 text-primary"></i>
                </div>
                <h2 class="fw-bold counter text-dark">+500</h2>
                <p class="text-muted text-uppercase small ls-2">Proyectos Activos</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="axon-card p-4 text-center">
                <div class="icon-circle bg-light-cyan mb-3">
                    <i class="bi bi-building-check fs-3 text-cyan"></i>
                </div>
                <h2 class="fw-bold counter text-dark">+120</h2>
                <p class="text-muted text-uppercase small ls-2">Partners Tecnológicos</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="axon-card p-4 text-center">
                <div class="icon-circle bg-light-success mb-3">
                    <i class="bi bi-lightning-charge-fill fs-3 text-success"></i>
                </div>
                <h2 class="fw-bold counter text-dark">+1.5k</h2>
                <p class="text-muted text-uppercase small ls-2">Sinapsis Exitosas</p>
            </div>
        </div>
    </div>
</div>

<div class="container py-5 mt-5">
    <div class="row align-items-center py-5">
        <div class="col-md-6 mb-4 mb-md-0">
            <h6 class="text-primary fw-bold text-uppercase ls-2">Para Reclutadores</h6>
            <h2 class="display-5 fw-bold mb-4 text-dark">Adquiere el <span class="text-primary">Core</span> de tu equipo</h2>
            <p class="text-muted mb-4 lead">
                Nuestros algoritmos de filtrado te permiten encontrar especialistas en
                .NET, Kotlin, Python y SQL con la formación técnica de Cibertec.
            </p>
            <div class="d-flex align-items-start mb-3">
                <div class="me-3 mt-1"><i class="bi bi-shield-check text-primary fs-4"></i></div>
                <div><h6 class="fw-bold mb-0">Candidatos Validados</h6><p class="small text-muted">Perfiles académicos actualizados en tiempo real.</p></div>
            </div>
            <div class="d-flex align-items-start mb-4">
                <div class="me-3 mt-1"><i class="bi bi-graph-up-arrow text-primary fs-4"></i></div>
                <div><h6 class="fw-bold mb-0">Gestión de Pipeline</h6><p class="small text-muted">Panel centralizado para control de procesos.</p></div>
            </div>
            <a asp-controller="Acceso" asp-action="Registrar" class="btn btn-outline-primary rounded-pill px-4">Saber más</a>
        </div>
        <div class="col-md-6 text-center">
            <div class="img-frame p-3 bg-white shadow-lg rounded-4">
                <img src="https://img.freepik.com/free-vector/job-interview-concept-illustration_114360-1677.jpg"
                     class="img-fluid rounded-4" alt="Talento IT">
            </div>
        </div>
    </div>
</div>

<style>
    /* Estilos Ultra Pro para AXON */
    .hero-axon {
        background: radial-gradient(circle at top right, #1e293b, #0f172a);
        min-height: 80vh;
        border-bottom: 4px solid var(--axon-neon);
    }

    .axon-grid-overlay {
        position: absolute;
        width: 100%;
        height: 100%;
        background-image: radial-gradient(rgba(0, 242, 255, 0.05) 1px, transparent 1px);
        background-size: 30px 30px;
        top: 0;
        left: 0;
    }

    .text-gradient {
        background: linear-gradient(90deg, #00f2ff, #007bff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .shadow-neon {
        box-shadow: 0 0 20px rgba(0, 242, 255, 0.3);
    }

    .axon-card {
        background: white;
        border-radius: 20px;
        border: none;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        transition: all 0.3s ease;
    }

        .axon-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 40px rgba(0, 242, 255, 0.15);
        }

    .icon-circle {
        width: 60px;
        height: 60px;
        border-radius: 15px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .bg-light-primary {
        background: rgba(0, 123, 255, 0.1);
    }

    .bg-light-cyan {
        background: rgba(0, 242, 255, 0.1);
    }

    .bg-light-success {
        background: rgba(40, 167, 69, 0.1);
    }

    .text-cyan {
        color: #00f2ff;
    }

    .ls-2 {
        letter-spacing: 2px;
    }

    /* Animación flotante para la imagen */
    .floating-axon {
        animation: float 6s ease-in-out infinite;
        filter: drop-shadow(0 0 15px rgba(0, 242, 255, 0.2));
    }

    @@keyframes float {
        0% {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-20px);
        }

        100% {
            transform: translateY(0px);
        }
    }

    .mt-n5 {
        margin-top: -3rem !important;
        z-index: 10;
    }
</style>