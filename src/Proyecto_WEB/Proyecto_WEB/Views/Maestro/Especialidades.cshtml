@model List<Proyecto_WEB.Models.Especialidad>

@{
    ViewData["Title"] = "Mantenimiento | AXON Admin";
}

<div class="container mt-5 animate__animated animate__fadeIn">
    @* --- HEADER --- *@
    <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-4 rounded-4 shadow-sm border-start border-primary border-4">
        <div>
            <h2 class="fw-bold text-dark mb-0"><i class="bi bi-mortarboard-fill text-primary me-2"></i> Especialidades</h2>
            <p class="text-muted small mb-0">Gestión de nodos académicos y áreas de especialización</p>
        </div>
        <button type="button" class="btn btn-axon shadow-neon-sm" data-bs-toggle="modal" data-bs-target="#modalNueva">
            <i class="bi bi-plus-lg me-1"></i> Nueva Especialidad
        </button>
    </div>

    @* --- TABLA --- *@
    <div class="axon-card border-0 overflow-hidden shadow-sm rounded-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-dark text-white">
                    <tr>
                        <th class="ps-4 py-3 text-uppercase fs-xs ls-1">Core ID</th>
                        <th class="py-3 text-uppercase fs-xs ls-1">Nombre de Especialidad</th>
                        <th class="text-end pe-4 py-3 text-uppercase fs-xs ls-1">Acciones de Sistema</th>
                    </tr>
                </thead>
                <tbody class="bg-white">
                    @foreach (var item in Model)
                    {
                        // 💡 Aplicamos el filtro visual de borrado lógico
                        string rowClass = item.Estado == "Inactivo" ? "opacity-50 grayscale-filter" : "";

                        <tr class="@rowClass">
                            <td class="ps-4">
                                <span class="badge bg-light text-primary border fw-mono">#@item.EspecialidadID.ToString("D3")</span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <span class="fw-bold text-dark">@item.Nombre</span>
                                    @if (item.Estado == "Inactivo")
                                    {
                                        <span class="badge bg-danger ms-2" style="font-size: 0.6rem;">DESHABILITADO</span>
                                    }
                                </div>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group shadow-sm rounded-pill overflow-hidden border">
                                    <button class="btn btn-white btn-sm border-end px-3" onclick="abrirEditar(@item.EspecialidadID)" title="Editar">
                                        <i class="bi bi-pencil-square text-primary"></i>
                                    </button>
                                    @* 💡 Usamos la ruta directa para evitar líos de POST/DELETE *@
                                    <a href="/Maestro/EliminarEspecialidad/@item.EspecialidadID"
                                       class="btn btn-white btn-sm px-3"
                                       onclick="return confirm('¿Seguro de cambiar el estado de este nodo, mi rey?')"
                                       title="@(item.Estado == "Inactivo" ? "Activar" : "Desactivar")">
                                        <i class="bi @(item.Estado == "Inactivo" ? "bi-play-circle-fill text-success" : "bi-power text-danger")"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* --- MODAL NUEVA --- *@
<div class="modal fade" id="modalNueva" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-dark text-white border-0 py-3">
                <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle-dotted me-2"></i> Registrar Nodo</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="GuardarEspecialidad" asp-controller="Maestro" method="post">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">NOMBRE DE ESPECIALIDAD</label>
                        <div class="input-group axon-input-group">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-tag-fill"></i></span>                            
                            <input type="text" name="nombre" class="form-control bg-light border-0" placeholder="Ej: Cloud Computing" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-axon px-4 shadow-neon-sm">Guardar Registro</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* --- MODAL EDITAR --- *@
<div class="modal fade" id="modalEditar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white border-0 py-3">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-fill me-2"></i> Actualizar Nodo</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>            
            <form asp-action="ActualizarEspecialidad" method="post">
                <div class="modal-body p-4">
                    <input type="hidden" id="editID" name="EspecialidadID" />
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">NOMBRE DE ESPECIALIDAD</label>
                        <div class="input-group axon-input-group">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-pencil-square"></i></span>
                            <input type="text" id="editNombre" name="Nombre" class="form-control bg-light border-0" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Descartar</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">Aplicar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .grayscale-filter {
        filter: grayscale(100%);
        transition: 0.4s;
    }

    .fs-xs {
        font-size: 0.75rem;
    }

    .ls-1 {
        letter-spacing: 1px;
    }

    .fw-mono {
        font-family: 'SFMono-Regular', Consolas, monospace;
    }

    .shadow-neon-sm {
        box-shadow: 0 0 10px rgba(0, 242, 255, 0.2);
    }

    .axon-card {
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }

    .btn-white {
        background: white;
        transition: all 0.2s;
        border: none;
    }

        .btn-white:hover {
            background: #f8f9fa;
            transform: scale(1.05);
        }
</style>

@section Scripts {
    <script>
        function abrirEditar(id) {
            fetch(`/Maestro/ObtenerEspecialidad/${id}`)
                .then(r => r.json())
                .then(data => {
                    // 💡 Manejo de nulos y nombres de propiedad del JSON de la API
                    document.getElementById('editID').value = data.especialidadID || data.EspecialidadID;
                    document.getElementById('editNombre').value = data.nombre || data.Nombre;
                    new bootstrap.Modal(document.getElementById('modalEditar')).show();
                })
                .catch(err => console.error("Error cargando especialidad:", err));
        }
    </script>
}