@model List<Proyecto_WEB.Models.OfertaTrabajo>
@{
    ViewData["Title"] = "Vacantes Disponibles | AXON";
}

<div class="container mt-5 animate__animated animate__fadeIn">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-bold text-dark mb-0">Vacantes Disponibles</h2>
            <p class="text-muted small">Explora las posiciones abiertas y postula a tu siguiente reto tech.</p>
        </div>
        <a href="javascript:history.back()" class="btn btn-light rounded-pill border px-4">Volver</a>
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Any(o => o.Estado == "Activa"))
        {
            @foreach (var oferta in Model.Where(o => o.Estado == "Activa"))
            {
                <div class="col-md-6">
                    <div class="axon-card p-4 border-0 shadow-sm bg-white rounded-4 h-100 d-flex flex-column">
                        <div class="mb-3">
                            <span class="badge bg-soft-primary text-primary mb-2">@oferta.Modalidad</span>
                            <h4 class="fw-bold text-dark">@oferta.Titulo</h4>
                            <p class="text-muted small mb-0"><i class="bi bi-geo-alt me-1"></i> @oferta.Ciudad</p>
                        </div>

                        <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                            <div>
                                <span class="d-block fw-bold text-dark">S/ @oferta.SalarioMin.ToString("N0") - @oferta.SalarioMax.ToString("N0")</span>
                                <small class="text-muted">Publicado el @oferta.FechaPublicacion.ToString("dd/MM/yyyy")</small>
                            </div>

                            @* 💡 Acción de Postular *@
                            <a asp-controller="Oferta" asp-action="Detalle" asp-route-id="@oferta.OfertaID"
                               class="btn btn-axon rounded-pill px-4 shadow-sm">
                                Ver Vacante <i class="bi bi-arrow-right-short ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-emoji-frown display-1 text-muted"></i>
                <h4 class="mt-3 text-secondary">Por ahora no hay vacantes activas</h4>
                <p class="text-muted">Esta empresa no tiene señales de empleo en este momento.</p>
            </div>
        }
    </div>
</div>

<style>
    .bg-soft-primary {
        background-color: rgba(13, 110, 253, 0.1);
    }

    .btn-axon {
        background: linear-gradient(45deg, #0d6efd, #00d4ff);
        color: white;
        border: none;
        font-weight: bold;
    }

        .btn-axon:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(13, 110, 253, 0.3);
            color: white;
        }

    .axon-card {
        transition: all 0.3s;
    }

        .axon-card:hover {
            transform: scale(1.02);
        }
</style>