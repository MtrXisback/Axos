@model dynamic
@{
    ViewData["Title"] = "Reconfigurar Perfil | AXON";

    // Extraemos info de la sesión para la lógica de la interfaz
    string rolActual = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    string emailUsuario = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ??
                          User.Identity.Name ?? "";
}

<div class="container mt-5 animate__animated animate__fadeIn">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="axon-card p-5 bg-white shadow-lg border-0 rounded-4">

                @* --- CABECERA --- *@
                <div class="text-center mb-4">
                    <div class="axon-icon-circle bg-light-primary mx-auto mb-3">
                        <i class="bi bi-shield-lock-fill text-primary display-6"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1">Reconfigurar Perfil</h3>
                    <p class="text-muted small">Ajustando los parámetros de tu nodo en la red AXON</p>
                    <span class="badge bg-soft-primary text-primary px-3 py-2 rounded-pill fw-bold">
                        ROL ACTUAL: @rolActual.ToUpper()
                    </span>
                </div>

                @* --- FORMULARIO DINÁMICO --- *@
                <form asp-controller="Usuario" asp-action="@(rolActual == "Empresa" ? "ActualizarEmpresa" : "ActualizarPerfil")" method="post">

                    @* Resumen de validación para detectar errores silenciosos *@
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    @if (rolActual == "Empresa")
                    {
                        @* --- BLOQUE EMPRESA --- *@
                        <input type="hidden" name="EmpresaID" value="@Model.EmpresaID" />
                        <input type="hidden" name="UsuarioID" value="@Model.UsuarioID" />

                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">RAZÓN SOCIAL</label>
                                <input type="text" name="NombreEmpresa" value="@Model.NombreEmpresa" class="form-control bg-light border-0 py-3" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">CORREO DE SISTEMA</label>
                                <input type="email" value="@emailUsuario" class="form-control bg-white border-0 py-3 text-muted" readonly title="El correo de acceso no se puede cambiar aquí" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">RUC</label>
                                <input type="text" name="RUC" value="@Model.RUC" class="form-control bg-white border-0 py-3 text-muted" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">PORTAL WEB</label>
                                <input type="text" name="SitioWeb" value="@Model.SitioWeb" class="form-control bg-light border-0 py-3" placeholder="https://..." />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-bold text-muted">DESCRIPCIÓN CORPORATIVA</label>
                                <textarea name="Descripcion" class="form-control bg-light border-0" rows="4" placeholder="Cuéntanos sobre la empresa...">@Model.Descripcion</textarea>
                            </div>
                        </div>
                    }
                    else
                    {
                        @* --- BLOQUE USUARIO (Candidato/Admin) --- *@
                        <input type="hidden" name="UsuarioID" value="@Model.UsuarioID" />
                        <input type="hidden" name="Rol" value="@rolActual" />

                        <div class="row g-4">
                            <div class="col-md-12">
                                <label class="form-label small fw-bold text-muted">NOMBRE COMPLETO</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-0"><i class="bi bi-person text-primary"></i></span>
                                    <input type="text" name="NombreCompleto" value="@Model.NombreCompleto" class="form-control bg-light border-0 py-3" required />
                                </div>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label small fw-bold text-muted">EMAIL DE CONTACTO</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-0"><i class="bi bi-envelope text-primary"></i></span>
                                    <input type="email" name="Email" value="@Model.Email" class="form-control bg-light border-0 py-3" required />
                                </div>
                            </div>
                        </div>
                    }

                    @* --- BOTONES DE ACCIÓN --- *@
                    <div class="mt-5 d-flex gap-3">
                        <button type="submit" class="btn btn-axon flex-grow-1 py-3 shadow-neon-sm fw-bold">
                            <i class="bi bi-cloud-arrow-up-fill me-2"></i>SINCRONIZAR CAMBIOS
                        </button>
                        <a asp-action="MiPerfil" class="btn btn-light py-3 px-4 fw-bold text-muted border">
                            CANCELAR
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .axon-card {
        border-radius: 24px;
    }

    .bg-light-primary {
        background-color: rgba(0, 123, 255, 0.08);
    }

    .bg-soft-primary {
        background-color: rgba(0, 123, 255, 0.1);
    }

    .axon-icon-circle {
        width: 80px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }

    .form-control:focus {
        background-color: #fff !important;
        box-shadow: 0 0 0 0.25rem rgba(0, 123, 255, 0.1);
        border: 1px solid #007bff !important;
    }

    .btn-axon {
        background: linear-gradient(45deg, #007bff, #00d4ff);
        color: white;
        border: none;
        border-radius: 12px;
        transition: all 0.3s;
    }

        .btn-axon:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 123, 255, 0.3);
            color: white;
        }

    .ls-1 {
        letter-spacing: 1px;
    }
</style>