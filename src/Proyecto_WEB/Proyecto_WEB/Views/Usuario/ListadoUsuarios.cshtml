@model List<Proyecto_WEB.Models.Usuario>

@{
    ViewData["Title"] = "Control de Usuarios | AXON Admin";
}

<div class="container mt-5 animate__animated animate__fadeIn">

    @* --- ALERTAS DE SISTEMA AXON --- *@
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 border-start border-success border-4 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
                <div>
                    <strong class="d-block">Sincronización Exitosa</strong>
                    <span class="small">@TempData["Mensaje"]</span>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* --- HEADER --- *@
    <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-4 rounded-4 shadow-sm border-start border-primary border-4">
        <div>
            <h2 class="fw-bold text-dark mb-0"><i class="bi bi-shield-lock-fill text-primary me-2"></i> Gestión de Usuarios</h2>
            <p class="text-muted small mb-0">Administración de nodos: Candidatos, Empresas y Staff</p>
        </div>
        <div class="text-end">
            <span class="badge bg-light text-primary border px-3 py-2 rounded-pill">
                <i class="bi bi-people-fill me-1"></i> @Model.Count Usuarios en Red
            </span>
        </div>
    </div>

    @* --- TABLA DE USUARIOS --- *@
    <div class="axon-card border-0 overflow-hidden shadow-sm rounded-4 bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-dark text-white">
                    <tr>
                        <th class="ps-4 py-3 text-uppercase fs-xs ls-1">Identidad / Nodo</th>
                        <th class="py-3 text-uppercase fs-xs ls-1">Canal de Contacto</th>
                        <th class="text-center py-3 text-uppercase fs-xs ls-1">Rol de Acceso</th>
                        <th class="text-end pe-4 py-3 text-uppercase fs-xs ls-1">Operaciones</th>
                    </tr>
                </thead>
                <tbody class="bg-white">
                    @foreach (var item in Model)
                    {
                        string rowClass = !item.Activo ? "opacity-50 grayscale-filter" : "";

                        <tr class="@rowClass">
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="axon-avatar-sm me-3 @(!item.Activo ? "bg-secondary shadow-none" : "")">
                                        @item.NombreCompleto.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <div class="d-flex align-items-center">
                                            <span class="fw-bold text-dark">@item.NombreCompleto</span>
                                            @if (!item.Activo)
                                            {
                                                <span class="badge bg-danger ms-2 px-2 py-1" style="font-size: 0.6rem;">SUSPENDIDO</span>
                                            }
                                        </div>
                                        <span class="text-muted fs-xs fw-mono">UID-@item.UsuarioID.ToString("D5")</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="icon-circle-sm bg-light me-2">
                                        <i class="bi bi-envelope-at text-primary"></i>
                                    </div>
                                    <span class="small text-muted">@item.Email</span>
                                </div>
                            </td>
                            <td class="text-center">
                                @{
                                    var (bgClass, icon) = item.Rol switch
                                    {
                                        "Admin" => ("bg-soft-danger text-danger", "bi-shield-check"),
                                        "Empresa" => ("bg-soft-info text-info", "bi-building-gear"),
                                        _ => ("bg-soft-success text-success", "bi-person-bounding-box")
                                    };
                                }
                                <span class="badge @bgClass rounded-pill px-3 py-2 border-0 fw-bold">
                                    <i class="bi @icon me-1"></i> @item.Rol.ToUpper()
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group rounded-pill overflow-hidden shadow-sm border bg-white">
                                    <a asp-action="ObtenerPorID" asp-route-id="@item.UsuarioID" class="btn btn-white btn-sm px-3" title="Ficha de Usuario">
                                        <i class="bi bi-search text-primary"></i>
                                    </a>

                                    <a asp-action="EliminarUsuario" asp-route-id="@item.UsuarioID"
                                       class="btn btn-white btn-sm px-3 border-start"
                                       onclick="return confirm('¿Confirmas el cambio de estado para @item.NombreCompleto?')"
                                       title="@(item.Activo ? "Suspender Acceso" : "Reactivar Acceso")">
                                        <i class="bi @(item.Activo ? "bi-person-x-fill text-danger" : "bi-person-check-fill text-success")"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* --- NAVEGACIÓN DE PÁGINAS (PAGINACIÓN) --- *@
    <div class="d-flex justify-content-between align-items-center mt-4 px-2 pb-5">
        <div class="text-muted small fw-bold">
            <i class="bi bi-layers-half me-1"></i> Bloque de Datos: @(ViewBag.PaginaActual ?? 1)
        </div>
        <nav aria-label="Navegacion AXON">
            <ul class="pagination pagination-sm mb-0">
                @* Botón Anterior *@
                <li class="page-item @(ViewBag.PaginaActual <= 1 ? "disabled" : "")">
                    <a class="page-link border-0 shadow-sm rounded-3 me-2 px-3 py-2 bg-white"
                       asp-action="ListadoUsuarios"
                       asp-route-pagina="@((ViewBag.PaginaActual ?? 1) - 1)">
                        <i class="bi bi-chevron-left me-1"></i> Anterior
                    </a>
                </li>

                @* Indicador de Página Actual *@
                <li class="page-item active">
                    <span class="page-link rounded-3 shadow-sm px-4 py-2 border-0 fw-bold bg-primary-gradient">
                        @(ViewBag.PaginaActual ?? 1)
                    </span>
                </li>

                @* Botón Siguiente *@
                <li class="page-item @(Model.Count < 10 ? "disabled" : "")">
                    <a class="page-link border-0 shadow-sm rounded-3 ms-2 px-3 py-2 bg-white"
                       asp-action="ListadoUsuarios"
                       asp-route-pagina="@((ViewBag.PaginaActual ?? 1) + 1)">
                        Siguiente <i class="bi bi-chevron-right ms-1"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<style>
    .grayscale-filter {
        filter: grayscale(100%);
        transition: 0.4s;
    }

    .axon-avatar-sm {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #007bff, #00f2ff);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        font-weight: bold;
        box-shadow: 0 4px 10px rgba(0, 123, 255, 0.2);
    }

    .bg-primary-gradient {
        background: linear-gradient(135deg, #007bff, #00f2ff) !important;
        color: white !important;
    }

    .icon-circle-sm {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .bg-soft-danger {
        background-color: #fee2e2 !important;
    }

    .bg-soft-info {
        background-color: #e0f7fa !important;
    }

    .bg-soft-success {
        background-color: #dcfce7 !important;
    }

    .btn-white {
        background: white;
        border: none;
        transition: 0.2s;
    }

        .btn-white:hover {
            background: #f8fafc;
            transform: scale(1.05);
        }

    /* Estilos Paginación */
    .page-link {
        color: #1e293b;
        font-size: 0.85rem;
        font-weight: 600;
        display: flex;
        align-items: center;
    }

    .page-item.disabled .page-link {
        background-color: #f1f5f9 !important;
        color: #94a3b8 !important;
        opacity: 0.6;
    }

    .fs-xs {
        font-size: 0.75rem;
    }

    .ls-1 {
        letter-spacing: 1px;
    }

    .fw-mono {
        font-family: 'SFMono-Regular', Consolas, monospace;
    }
</style>